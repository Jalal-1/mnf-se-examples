{
  "name": "mnf-se-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*/contract",
    "apps/*/cli",
    "apps/web"
  ],
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/platform-js": "2.2.4",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.1",
    "ws": "^8.19.0"
  },
  "scripts": {
    "postinstall": "npx patch-package",
    "docker:up": "bash scripts/docker-up.sh",
    "docker:down": "docker compose -f docker/standalone.yml down",
    "docker:logs": "docker compose -f docker/standalone.yml logs -f",
    "docker:reset": "docker compose -f docker/standalone.yml down -v && bash scripts/docker-up.sh",
    "docker:proof": "bash scripts/docker-proof.sh",
    "counter": "npm -w @mnf-se/counter-cli run standalone",
    "token": "npm -w @mnf-se/token-cli run standalone",
    "election": "npm -w @mnf-se/election-cli run standalone",
    "fungible-token": "npm -w @mnf-se/fungible-token-cli run standalone",
    "nft": "npm -w @mnf-se/nft-cli run standalone",
    "multi-token": "npm -w @mnf-se/multi-token-cli run standalone",
    "access-control": "npm -w @mnf-se/access-control-cli run standalone",
    "multisig": "npm -w @mnf-se/multisig-cli run standalone",
    "multisig-token": "npm -w @mnf-se/multisig-token-cli run standalone",
    "oz-multisig-v3": "npm -w @mnf-se/oz-multisig-v3-cli run standalone",
    "counter:undeployed": "npm -w @mnf-se/counter-cli run undeployed",
    "token:undeployed": "npm -w @mnf-se/token-cli run undeployed",
    "election:undeployed": "npm -w @mnf-se/election-cli run undeployed",
    "fungible-token:undeployed": "npm -w @mnf-se/fungible-token-cli run undeployed",
    "nft:undeployed": "npm -w @mnf-se/nft-cli run undeployed",
    "multi-token:undeployed": "npm -w @mnf-se/multi-token-cli run undeployed",
    "access-control:undeployed": "npm -w @mnf-se/access-control-cli run undeployed",
    "multisig:undeployed": "npm -w @mnf-se/multisig-cli run undeployed",
    "multisig-token:undeployed": "npm -w @mnf-se/multisig-token-cli run undeployed",
    "oz-multisig-v3:undeployed": "npm -w @mnf-se/oz-multisig-v3-cli run undeployed",
    "counter:preview": "npm -w @mnf-se/counter-cli run preview",
    "counter:preprod": "npm -w @mnf-se/counter-cli run preprod",
    "token:preview": "npm -w @mnf-se/token-cli run preview",
    "token:preprod": "npm -w @mnf-se/token-cli run preprod",
    "election:preview": "npm -w @mnf-se/election-cli run preview",
    "election:preprod": "npm -w @mnf-se/election-cli run preprod",
    "fungible-token:preview": "npm -w @mnf-se/fungible-token-cli run preview",
    "fungible-token:preprod": "npm -w @mnf-se/fungible-token-cli run preprod",
    "nft:preview": "npm -w @mnf-se/nft-cli run preview",
    "nft:preprod": "npm -w @mnf-se/nft-cli run preprod",
    "multi-token:preview": "npm -w @mnf-se/multi-token-cli run preview",
    "multi-token:preprod": "npm -w @mnf-se/multi-token-cli run preprod",
    "access-control:preview": "npm -w @mnf-se/access-control-cli run preview",
    "access-control:preprod": "npm -w @mnf-se/access-control-cli run preprod",
    "multisig:preview": "npm -w @mnf-se/multisig-cli run preview",
    "multisig:preprod": "npm -w @mnf-se/multisig-cli run preprod",
    "multisig-token:preview": "npm -w @mnf-se/multisig-token-cli run preview",
    "multisig-token:preprod": "npm -w @mnf-se/multisig-token-cli run preprod",
    "oz-multisig-v3:preview": "npm -w @mnf-se/oz-multisig-v3-cli run preview",
    "oz-multisig-v3:preprod": "npm -w @mnf-se/oz-multisig-v3-cli run preprod",
    "web": "npm -w @mnf-se/web run dev",
    "web:build": "npm -w @mnf-se/web run build",
    "web:preview": "npm -w @mnf-se/web run preview",
    "build:counter": "cd apps/counter/contract && npm run compact && npm run build",
    "build:token": "cd apps/token/contract && npm run compact && npm run build",
    "build:election": "cd apps/election/contract && npm run compact && npm run build",
    "build:fungible-token": "cd apps/fungible-token/contract && npm run compact && npm run build",
    "build:nft": "cd apps/nft/contract && npm run compact && npm run build",
    "build:multi-token": "cd apps/multi-token/contract && npm run compact && npm run build",
    "build:access-control": "cd apps/access-control/contract && npm run compact && npm run build",
    "build:multisig": "cd apps/multisig/contract && npm run compact && npm run build",
    "build:multisig-token": "cd apps/multisig-token/contract && npm run compact && npm run build",
    "build:oz-multisig-v3": "cd apps/oz-multisig-v3/contract && npm run compact && npm run build",
    "build:all": "npm run build:counter && npm run build:token && npm run build:election && npm run build:fungible-token && npm run build:nft && npm run build:multi-token && npm run build:access-control && npm run build:multisig && npm run build:multisig-token && npm run build:oz-multisig-v3",
    "typecheck": "npx tsc -p apps/counter/cli/tsconfig.json --noEmit && npx tsc -p apps/token/cli/tsconfig.json --noEmit && npx tsc -p apps/election/cli/tsconfig.json --noEmit && npx tsc -p apps/fungible-token/cli/tsconfig.json --noEmit && npx tsc -p apps/nft/cli/tsconfig.json --noEmit && npx tsc -p apps/multi-token/cli/tsconfig.json --noEmit && npx tsc -p apps/access-control/cli/tsconfig.json --noEmit && npx tsc -p apps/multisig/cli/tsconfig.json --noEmit && npx tsc -p apps/multisig-token/cli/tsconfig.json --noEmit && npx tsc -p apps/oz-multisig-v3/cli/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "patch-package": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "smoldot": "npm:@aspect-build/empty@0.0.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/platform-js": "2.2.4"
  }
}
